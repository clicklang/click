int64 FeeFrac_EvaluateFeeUp(const struct FeeFrac* this, int32 at_size) {
    views this->fee;
    views this->size;
    requires this->fee >= 0i64;
    requires this->fee < 8589934592i64;
    requires 0 <= to_integer(this->fee);
