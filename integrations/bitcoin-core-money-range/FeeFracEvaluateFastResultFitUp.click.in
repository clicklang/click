    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires to_integer(this->fee) * to_integer(at_size) <= 9223372036854775807 * to_integer(this->size);
    requires this->size > 0;
    requires this->size <= 2147483647;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures 0 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures to_integer(this->fee) * to_integer(at_size) <= to_integer(result) * to_integer(this->size);
    ensures (to_integer(result) + -1) * to_integer(this->size) < to_integer(this->fee) * to_integer(at_size);
    ensures to_integer(result) == truncating_quotient(to_integer(this->fee) * to_integer(at_size) + to_integer(this->size) - 1, to_integer(this->size));
} by { execute(); simp(); }

