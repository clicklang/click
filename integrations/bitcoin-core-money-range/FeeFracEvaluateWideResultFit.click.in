int64 FeeFrac::EvaluateFee<@INSTANCE@>(int32 at_size) const {
    views this->fee;
    views this->size;
    requires @WIDE_GUARD@;
    requires -9223372036854775808 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 9223372036854775807;
    requires this->size > 0;
    requires this->size <= 2147483647;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires @INPUT_BOUND_1@;
    requires @INPUT_BOUND_2@;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures -9223372036854775808 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures @CALLER_BOUND_1@;
    ensures @CALLER_BOUND_2@;
} by {
    have 1 <= this->size by {
        apply(integer::lt_step_le(0, to_integer(this->size)));
        close();
    }
    have -2147483648 <= to_integer(at_size) by { close() using { 0 <= to_integer(at_size); } }
    step_until(call(0).entry);
    mark denominator;
    let { result: product } = step(FeeFrac::Mul, { });
    have @PRODUCT_BOUND_1@ by {
        rewrite(to_integer(product), to_integer(this->fee) * to_integer(at_size));
        close();
    }
    have @PRODUCT_BOUND_2@ by {
        rewrite(to_integer(product), to_integer(this->fee) * to_integer(at_size));
        close();
    }
    step_until(call(1).entry);
    // Name the call's actual arguments in the preconditions so its
    // certificate can reuse the saved product and the selected rounding mode.
    let { result: rounded } = step(FeeFrac::Div, { }) {
        requires @INSTANCE@ == @INSTANCE@ by { close(); }
        requires @PRODUCT_BOUND_1@ by { close(); }
        requires @PRODUCT_BOUND_2@ by { close(); }
        requires this->size > 0 by { close(); }
        requires this->size <= 2147483647 by { close(); }
    }
    step_until(function.exit);
    have @DIV_BOUND_1@;
    have @DIV_BOUND_2@;
    have to_integer(result) == to_integer(rounded);
    have to_integer(this->fee) * to_integer(at_size) == to_integer(product);
    have to_integer(this->size) == to_integer(at(denominator, this->size));
    have @CALLER_BOUND_1@ by {
        rewrite(to_integer(result), to_integer(rounded));
        rewrite(to_integer(this->size), to_integer(at(denominator, this->size)));
        rewrite(to_integer(this->fee) * to_integer(at_size), to_integer(product));
        close();
    }
    have @CALLER_BOUND_2@ by {
        rewrite(to_integer(result), to_integer(rounded));
        rewrite(to_integer(this->size), to_integer(at(denominator, this->size)));
        rewrite(to_integer(this->fee) * to_integer(at_size), to_integer(product));
        close();
    }
    close();
}
int64 FeeFrac::EvaluateFee@MODE@(int32 at_size) const {
    views this->fee;
    views this->size;
    requires @WIDE_GUARD@;
    requires -9223372036854775808 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 9223372036854775807;
    requires this->size > 0;
    requires this->size <= 2147483647;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires @INPUT_BOUND_1@;
    requires @INPUT_BOUND_2@;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures -9223372036854775808 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures @CALLER_BOUND_1@;
    ensures @CALLER_BOUND_2@;
}

contract int64 OversizeFee(const struct FeeFrac* this, int32 at_size) {
    requires this->fee == @FEE_WITNESS@i64;
    requires this->size == 1;
    requires at_size == 2;
    views this->fee;
    views this->size;
    requires @WIDE_GUARD@;
    requires -9223372036854775808 <= to_integer(this->fee);
    requires to_integer(this->fee) <= 9223372036854775807;
    requires this->size > 0;
    requires this->size <= 2147483647;
    requires 0 <= at_size;
    requires at_size <= 2147483647;
    requires @INPUT_BOUND_1@;
    requires @INPUT_BOUND_2@;
    ensures this->fee == old(this->fee);
    ensures this->size == old(this->size);
    ensures -9223372036854775808 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures @CALLER_BOUND_1@;
    ensures @CALLER_BOUND_2@;
}

theorem oversize_fee_evaluation() {
    ensures OversizeFee(&FeeFrac::EvaluateFee@MODE@) by {
        unfold(OversizeFee(&FeeFrac::EvaluateFee@MODE@));
        close();
    }
}
