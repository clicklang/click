int64 CFeeRate::GetFee(int32 virtual_bytes) const {
    views this->m_feerate.base.fee;
    views this->m_feerate.base.size;
    requires 0 <= virtual_bytes;
    requires virtual_bytes <= 2147483647;
    requires this->m_feerate.base.size >= 0;
    requires this->m_feerate.base.size <= 2147483647;
    requires this->m_feerate.base.size != 0 implies -9223372036854775808 <= to_integer(this->m_feerate.base.fee);
    requires this->m_feerate.base.size != 0 implies to_integer(this->m_feerate.base.fee) <= 9223372036854775807;
    requires this->m_feerate.base.size != 0 implies -9223372036854775809 * to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes);
    requires this->m_feerate.base.size != 0 implies to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= 9223372036854775807 * to_integer(this->m_feerate.base.size);
    ensures this->m_feerate.base.fee == old(this->m_feerate.base.fee);
    ensures this->m_feerate.base.size == old(this->m_feerate.base.size);
    ensures this->m_feerate.base.size == 0 implies result == 0i64;
    ensures -9223372036854775808 <= to_integer(result);
    ensures to_integer(result) <= 9223372036854775807;
    ensures this->m_feerate.base.size != 0 implies
        ((to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= to_integer(result) * to_integer(this->m_feerate.base.size)
          and (to_integer(result) + -1) * to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes))
         or (result == -1i64 and virtual_bytes != 0 and this->m_feerate.base.fee < 0i64
             and -to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes)
             and to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= 0));
    ensures this->m_feerate.base.size != 0 implies (virtual_bytes != 0 implies (this->m_feerate.base.fee < 0i64 implies result != 0i64));
} by {
    step_until(call(0).entry);
    let { result: empty } = step(FeeFrac::IsEmpty, { });
    branch {
        true => {
            have this->m_feerate.base.size == 0;
            step_until(function.exit); close();
        }
        false => {
        }
    }
    have not (this->m_feerate.base.size == 0);
    have this->m_feerate.base.size > 0 by {
        if this->m_feerate.base.size > 0 {
            close();
        } else {
            have this->m_feerate.base.size == 0 by {
                apply(integer::int32_less_equal_and_not_less_than_implies_equal(0, this->m_feerate.base.size));
                close();
            }
            contradiction(this->m_feerate.base.size == 0);
        }
    }
    have -9223372036854775808 <= to_integer(this->m_feerate.base.fee);
    have to_integer(this->m_feerate.base.fee) <= 9223372036854775807;
    have -9223372036854775809 * to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes);
    have to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= 9223372036854775807 * to_integer(this->m_feerate.base.size);
    step_until(call(1).entry);
    let { result: rounded } = step(FeeFrac::EvaluateFeeUp, { });
    if rounded == 0i64 {
        have to_integer(rounded) == 0 by { rewrite(rounded, 0i64); close(); }
        have to_integer(rounded) * to_integer(this->m_feerate.base.size) == 0 by { rewrite(to_integer(rounded), 0); close(); }
        have (to_integer(rounded) + -1) * to_integer(this->m_feerate.base.size) == -to_integer(this->m_feerate.base.size) by { rewrite(to_integer(rounded), 0); close() using {}; }
        have to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= 0 by {
            rewrite(0, to_integer(rounded) * to_integer(this->m_feerate.base.size));
            close();
        }
        have -to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) by {
            rewrite(-to_integer(this->m_feerate.base.size), (to_integer(rounded) + -1) * to_integer(this->m_feerate.base.size));
            close();
        }
        if virtual_bytes != 0 {
            if this->m_feerate.base.fee < 0i64 {
                step_until(function.exit);
                have result == -1i64 by { close(); }
                have this->m_feerate.base.size != 0 implies
                    ((to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= to_integer(result) * to_integer(this->m_feerate.base.size)
                      and (to_integer(result) + -1) * to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes))
                     or (result == -1i64 and virtual_bytes != 0 and this->m_feerate.base.fee < 0i64
                         and -to_integer(this->m_feerate.base.size) < to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes)
                         and to_integer(this->m_feerate.base.fee) * to_integer(virtual_bytes) <= 0)) by { intro() { close(); } }
                close();
            } else {
                step_until(function.exit); close();
            }
        } else {
            step_until(function.exit); close();
        }
    } else {
        step_until(function.exit); close();
    }
}
