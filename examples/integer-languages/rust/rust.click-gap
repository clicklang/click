// Cases of the cross-language integer fixture that Rust does not verify
// yet, with the claims and proof the other languages verify. This is not a
// `.click` file, so the corpus tools leave it alone;
// `tests/examples/integer_languages.rs` checks that each gap remains one.
//
// `wrapping_*`: Charon imports `u32::wrapping_add` and the rest as calls the
// Rust frontend does not model ("unmodeled external call"); their source is
// in `gaps.rs`, outside the crate. `narrow_i8`: Rust lowers `x as i8` to
// `((x & 255) ^ 128) - 128`, which `integer_cast_identity` does not read as a
// cast (`design/machine-integers.md`, Stage 4).

import click::integer;

verifying "integers.rs";

fn wrapping_add_u32(a: u32, b: u32) -> u32 {
    ensures result == integer::uint32_wrapping_add(a, b);
}

fn wrapping_sub_u32(a: u32, b: u32) -> u32 {
    ensures result == integer::uint32_wrapping_sub(a, b);
}

fn wrapping_mul_u32(a: u32, b: u32) -> u32 {
    ensures result == integer::uint32_wrapping_mul(a, b);
}

fn narrow_i8(x: i32) -> i8 {
    ensures (-128 <= x and x <= 127) implies to_integer(result) == to_integer(x);
    ensures x == 200 implies to_integer(result) == -56;
    ensures x == -129 implies to_integer(result) == 127;
} by {
    if -128 <= x and x <= 127 {
        step_until(function.exit);
        have -128 <= to_integer(x);
        have to_integer(x) <= 127;
        have to_integer(result) == to_integer(x) by {
            arithmetic_certificate rules {
                premise 0: -128 <= to_integer(x) => -128 <= to_integer(x);
                premise 1: to_integer(x) <= 127 => to_integer(x) <= 127;
                integer_cast_identity bounds [0, 1] => to_integer(result) == to_integer(x);
                conclusion 0;
            }
        };
        solve();
    } else {
        step_until(function.exit);
        solve();
    }
}

fn wrapping_add_u64(a: u64, b: u64) -> u64 {
    ensures result == integer::uint64_wrapping_add(a, b);
}
