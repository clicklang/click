ide(x, 2)?;\n    divide(half, 2)\n}\n\npub fn error_code(r: Result<u32, u8>) -> u8 {\n    if let Err(code) = r { code } else { 0 }\n}\n\npub fn same<T: Copy, E: Copy>(r: Result<T, E>) -> Result<T, E> {\n    let v = r?;\n    Ok(v)\n}\n\npub fn kept(x: i32) -> Result<i32, bool> {\n    same(Ok(x))\n}\n\npub fn must(r: Result<u32, u8>) -> u32 {\n    r.unwrap()\n}\n\npub fn must_say(r: Result<u32, u8>) -> u32 {\n    r.expect(\"a value\")\n}\n\npub fn or_default(r: Result<u32, u8>, d: u32) -> u32 {\n    r.unwrap_or(d)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/fmt/num.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["result_values",0]},{"Ident":["round",0]}]},{"key":{"Fun":1},"value":[{"Ident":["result_values",0]},{"Ident":["plus_one",0]}]},{"key":{"Fun":2},"value":[{"Ident":["result_values",0]},{"Ident":["quarter",0]}]},{"key":{"Fun":3},"value":[{"Ident":["result_values",0]},{"Ident":["error_code",0]}]},{"key":{"Fun":4},"value":[{"Ident":["result_values",0]},{"Ident":["kept