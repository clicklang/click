weaker semantics."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<Unique<T>>` has the same size as `Unique<T>`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `Unique<T>` is covariant over `T`. This should always be correct"},{"DocComment":" for any type which upholds Unique's aliasing requirements."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null}],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["resource_state",0]},{"Ident":["through",0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":38,"col":0},"end":{"line":40,"col":1}},"generated_from_span":null}},"source_text":"pub fn through(slot: &mut Slot, x: u32) -> u32 {\n    refill(slot, x)\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signatur