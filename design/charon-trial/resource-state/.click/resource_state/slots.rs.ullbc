"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker for types that can be dropped."},{"DocComment":""},{"DocComment":" This should be used for `[const]` bounds,"},{"DocComment":" as non-const bounds will always hold for every type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"Destruct","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":2,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":81}],"output":{"Deduplicated":14}},"default":null},"kind":{"TraitMethod":[3,0]}}],"vtable":null},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":201,"col":0},"end":{"line":201,"col":32}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An implementation of `Allocator` can allocate, grow, shrink, and deallocate arbitrary blocks of"},{"DocComment":" data described via [`Layout`][]."},{"DocComment":""},{"DocComment":" `Allocator` is mostly designed to be implemented on ZSTs, references, or smart pointers,"},{"DocComment":" but can also be implemented directly on the underlying memory-owning type so long as it"},{"DocComment":" upholds the necessary guarantees. In general, an allocator of the type `MyAlloc([u8; N])`"},{"DocComment":" cannot be soundly created without being pinned or otherwise immovable in order to be"},{"DocComment":" correct."},{"DocComment":""},{"DocComment":" In contrast to [`GlobalAlloc`][], `Allocator` allows zero-sized allocations. If an underlying"},{"DocComment":" allocator does not support this (like jemalloc) or responds by returning a null pointer"},{"DocComment":" (such as `libc::malloc`), this must be caught by the implementation."},{"DocComment":""},{"DocComment":" In order to be usable in a flexible manner while still being sound, implementors of the trait"},{"DocComment":" must uphold very detailed semantics as explained below; the following terms are thus provided"},{"DocComment":" as vocabulary for allocator safety and implementation requirements:"},{"DocComment":""},{"DocComment":" ### Equivalent allocators"},{"DocComment":""},{"DocComment":" Multiple allocator values can sometimes be interchangeable with each other."},{"DocComment":" When this is the case, we refer to those allocators as being *equivalent* to"},{"DocComment":" each other."},{"DocComment":""},{"DocComment":" Users of allocators may assume the following are true of equivalent allocators,"},{"DocComment":" and implementors must ensure these rules are upheld:"},{"DocComment":" * An allocator is equivalent to itself. (Equivalence is reflexive.)"},{"DocComment":" * If an allocator is equivalent to a second allocator, then"},{"DocComment":"   the second allocator is also equivalent to the first. (Equivalence is symmetric.)"},{"DocComment":" * If an allocator is equivalent to a second allocator, and"},{"DocComment":"   the second allocator is equivalent to a third allocator, then"},{"DocComment":"   the first allocator is also equivalent to the third allocator."},{"DocComment":"   (Equivalence is transitive.)"},{"DocComment":" * Moving, subtyping, unsize-coercing, or trait-upcasting an allocator does not change"},{"DocComment":"   what the allocator is equivalent to."},{"DocComment":" * Copying or cloning an allocator creates an equivalent one, should the"},{"DocComment":"   [`AllocatorClone`] trait be implemented."},{"DocComment":""},{"DocComment":" Additionally, implementors of `Allocator` may specify additional equivalences"},{"DocComment":" between allocators. It is the responsibility of such implementors to make sure"},{"DocComment":" that equivalent allocators have \"compatible\" `Allocator` implementations."},{"DocComment":" In particular, the standard library specifies the following equivalences:"},{"DocComment":" * A reference to an allocator (either `&` or `&mut`) is equivalent to"},{"DocComment":"   the allocator being referenced."},{"DocComment":" * A `Box`, `Rc`, or `Arc` containing an allocator is equivalent to"},{"DocComment":"   the allocator inside."},{"DocComment":" * All `Global` allocator instances are equivalent with each other."},{"DocComment":" * All `System` allocator instances are equivalent with each other."},{"DocComment":""},{"DocComment":" ### Currently allocated memory"},{"DocComment":""},{"DocComment":" Some of the methods require that a memory block is *currently allocated* by some specific allocator."},{"DocComment":" This means that:"},{"DocComment":" * the starting address for that memory block was previously returned by"},{"DocComment":"   the [`allocate`], [`allocate_zeroed`], [`grow`], [`grow_zeroed`], or [`shrink`] methods,"},{"DocComment":"   called on an allocator that's equivalent to this specific allocator; and"},{"DocComment":" * the memory block has not subsequently been [*invalidated*]."},{"DocComment":""},{"DocComment":" ### Invalidating memory blocks"},{"DocComment":""},{"DocComment":" A memory block that is currently allocated becomes *invalidated* when one"},{"DocComment":" of the following happens:"},{"DocComment":" * The memory block is deallocated. This occurs when the memory block"},{"DocComment":"   is passed as an argument to a [`deallocate`] call, or when it is passed"},{"DocComment":"   as an argument to a [`grow`], [`grow_zeroed`] or [`shrink`] call that returns `Ok`."},{"DocComment":" * For all (equivalent) allocators that this memory block is currently allocated by, at"},{"DocComment":"   least one of the following has occurred:"},{"DocComment":"   * The allocator's destructor runs."},{"DocComment":"   * The allocator is mutated through a public or otherwise untrusted API taking `&mut` access."},{"DocComment":"   * One of the borrow-checker lifetimes in the allocator's type expires."},{"DocComment":""},{"DocComment":" Note that these conditions imply that a collection may ensure that"},{"DocComment":" any specific currently allocated memory block won't be invalidated by:"},{"DocComment":" * not deallocating that memory block,"},{"DocComment":" * owning an allocator that memory block is allocated with, and"},{"DocComment":" * not publicly exposing `&mut` access to that allocator."},{"DocComment":""},{"DocComment":" Also note that safe public API of an allocator with `&` access is not"},{"DocComment":" allowed to invalidate its memory blocks. Furthermore, unsafe public API"},{"DocComment":" of an allocator with `&` access must document that they invalidate"},{"DocComment":" memory blocks (e.g., by calling `deallocate`) if they do. Therefore,"},{"DocComment":" a collection may safely expose `&` access to its allocator."},{"DocComment":""},{"DocComment":" Also note that, even in cases where there are other \"alive\" allocators known"},{"DocComment":" to be equivalent to a given collection's allocator, most collections still should"},{"DocComment":" not publicly expose `&mut` access to their allocators. The fact that there are"},{"DocComment":" other \"alive\" allocators would prevent this `&mut` access from invalidating"},{"DocComment":" the collection's memory block, but public `&mut` access is still likely to"},{"DocComment":" be unsound, since a user could replace the collection's allocator with"},{"DocComment":" a non-equivalent allocator, causing the collection to deallocate its memory"},{"DocComment":" with the wrong allocator."},{"DocComment":""},{"DocComment":" [`allocate`]: Allocator::allocate"},{"DocComment":" [`allocate_zeroed`]: Allocator::allocate_zeroed"},{"DocComment":" [`grow`]: Allocator::grow"},{"DocComment":" [`grow_zeroed`]: Allocator::grow_zeroed"},{"DocComment":" [`shrink`]: Allocator::shrink"},{"DocComment":" [`deallocate`]: Allocator::deallocate"},{"DocComment":""},{"DocComment":" ### Memory fitting"},{"DocComment":""},{"DocComment":" Some of the methods require that a `layout` *fits* a memory block or vice versa. This means"},{"DocComment":" that the following conditions must hold:"},{"DocComment":"  * the memory block must be *currently allocated* with alignment of [`layout.align()`], and"},{"DocComment":"  * [`layout.size()`] must fall in the range `min ..= max`, where:"},{"DocComment":"    - `min` is the size of the layout used to allocate the block, and"},{"DocComment":"    - `max` is the actual size returned from [`allocate`], [`allocate_zeroed`],"},{"DocComment":"      [`grow`], [`grow_zeroed`], or [`shrink`]."},{"DocComment":""},{"DocComment":" [`layout.align()`]: Layout::align"},{"DocComment":" [`layout.size()`]: Layout::size"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Implementors of `Allocator` must ensure that a memory block that"},{"DocComment":" is [*currently allocated*] by the allocator points to valid memory"},{"DocComment":" until that memory block is [*invalidated*]. The implementor must also"},{"DocComment":" not violate this invariant of `Allocator` via allocator equivalences"},{"DocComment":" that are in the implementor's control."},{"DocComment":""},{"DocComment":" Additionally, any memory block returned by the allocator must"},{"DocComment":" satisfy the allocation invariants described in `core::ptr`."},{"DocComment":" In particular, if a block has base address `p` and size `n`,"},{"DocComment":" then `p as usize + n <= usize::MAX` must hold. These blocks must also"},{"DocComment":" be wholly disjoint."},{"DocComment":""},{"DocComment":" This ensures that pointer arithmetic within the allocation"},{"DocComment":" (for example, `ptr.add(len)`) cannot overflow the address space, and"},{"DocComment":" that it is possible to perform nonoverlapping copies between allocations."},{"DocComment":""},{"DocComment":" None of the allocating or deallocating methods may unwind. This restriction"},{"DocComment":" may be lifted in the future by ensuring unwinding out of an allocating function always"},{"DocComment":" aborts. If an implementor of `Allocator` also has drop glue or directly implements `Drop`,"},{"DocComment":" dropping the allocator must not result in an unwind."},{"DocComment":""},{"DocComment":" It is undefined behavior for the allocator to read, write, or deallocate any memory that"},{"DocComment":" is currently allocated. This memory is owned by the user; the allocator must not touch it."},{"DocComment":""},{"DocComment":" Lastly, the methods on this trait must be *correct*; in particular, the layout requested"},{"DocComment":" must be respected, calls must zero out memory if the documentation so requires,"},{"DocComment":" returning an `AllocError` from a reallocating method must indeed ensure that"},{"DocComment":" the old pointer was not invalidated, and de/reallocating calls must accept layouts"},{"DocComment":" in the ranges defined by their documentation."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*invalidated*]: #invalidating-memory-blocks"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[96,{"data":{"file_id":7,"beg":{"line":201,"col":0},"end":{"line":466,"col":1}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":1},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"allocate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]},{"Ident":["allocate",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":234,"col":4},"end":{"line":234,"col":76}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Attempts to allocate a block of memory."},{"DocComment":""},{"DocComment":" On success, returns a [`NonNull<[u8]>`][NonNull] meeting the size and alignment"},{"DocComment":" guarantees of `layout`. The returned block may have a larger size than specified"},{"DocComment":" by `layout.size()`, and may or may not have its contents initialized."},{"DocComment":""},{"DocComment":" It is recommended that overallocating as per the above is only performed if doing so"},{"DocComment":" is cheap; there is no guarantee that the caller is able to take advantage of the"},{"DocComment":" returned excess. Implementors are free to e.g. provide an alternate method to query"},{"DocComment":" available excess if doing so is expensive and should be left to the caller."},{"DocComment":""},{"DocComment":" Note that the returned block of memory is considered [*currently allocated*]"},{"DocComment":" with this allocator (and equivalent allocators)."},{"DocComment":" Therefore, it is the responsibility of implementors of `Allocator` to make sure that"},{"DocComment":" this block of memory remains valid until it is [*invalidated*]."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*invalidated*]: #invalidating-memory-blocks"},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returning `Err` indicates that either memory is exhausted or `layout` does not meet"},{"DocComment":" allocator's size or alignment constraints."},{"DocComment":""},{"DocComment":" Implementations are encouraged to return `Err` on memory exhaustion rather than"},{"DocComment":" aborting, but this is not a strict requirement. (Specifically: it is *legal* to implement"},{"DocComment":" this trait atop an underlying native allocation library that aborts on memory exhaustion.)"},{"DocComment":""},{"DocComment":" Clients wishing to abort computation in response to an allocation error are encouraged to"},{"DocComment":" call the [`handle_alloc_error`] function, rather than directly invoking `panic!` or similar."},{"DocComment":""},{"DocComment":" [`handle_alloc_error`]: ../../alloc/alloc/fn.handle_alloc_error.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[82,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":0},"Shared"]}]},{"Deduplicated":66}],"output":{"Deduplicated":67}},"default":null},"kind":{"TraitMethod":[4,0]}},null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deallocate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]},{"Ident":["deallocate",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":274,"col":4},"end":{"line":274,"col":66}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Deallocates the memory referenced by `ptr`."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" * `ptr` must denote a block of memory [*currently allocated*] via this allocator, and"},{"DocComment":" * `layout` must [*fit*] that block of memory."},{"DocComment":""},{"DocComment":" Note that it is *immediate* language UB for a deallocation or reallocation to"},{"DocComment":" invalidate any outstanding references, smart pointers, etc.; thus, notably, an"},{"DocComment":" allocator that has been moved into its own [*currently allocated*] memory may"},{"DocComment":" not have its backing memory be freed, even if the allocator is never used again"},{"DocComment":" afterwards. This is due to the fact that such a deallocation would invalidate the"},{"DocComment":" `&self` reference passed to this method."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*fit*]: #memory-fitting"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":82},{"Deduplicated":72},{"Deduplicated":66}],"output":{"Deduplicated":14}},"default":null},"kind":{"TraitMethod":[4,2]}},null,null,null],"vtable":{"id":8,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["resource_state",0]},{"Impl":{"Trait":0}}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":14,"col":0},"end":{"line":26,"col":1}},"generated_from_span":null}},"source_text":"impl Store<u32> for Slot {\n    fn put(&mut self, x: u32) {\n        let _old = self.item.take();\n        self.item = Some(Box::new(Cell { value: x }));\n    }\n\n    fn take_or(&mut self, fallback: u32) -> u32 {\n        match self.item.take() {\n            Some(cell) => cell.value,\n            None => fallback,\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":22},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[{"Deduplicated":13},{"Value":[33,{"kind":{"BuiltinOrAuto":{"builtin_data":"Sized","parent_trait_refs":[{"Value":[34,{"kind":{"BuiltinOrAuto":{"builtin_data":"MetaSized","parent_trait_refs":[],"types":[],"vtable":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}]}],"types":[],"vtable":null}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"D