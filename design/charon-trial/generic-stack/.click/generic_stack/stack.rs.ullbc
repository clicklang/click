t":{"Value":[16,[{"SizeOf":{"Deduplicated":16}},{"Deduplicated":6}]]}}]}]}]}]}]},"target_align":{"Value":[38,{"Max":[{"Deduplicated":28},{"Value":[39,{"Constant":{"Value":[17,[{"AlignOf":{"Deduplicated":16}},{"Deduplicated":6}]]}}]}]}]}}}]}}]}},"align":{"chosen":null,"guarantee":{"Value":[40,{"AtLeast":{"Deduplicated":38}}]}},"discriminator":null,"inhabited":{"Value":[4,{"And":[{"Deduplicated":2},{"Value":[5,{"GenericType":{"Deduplicated":16}}]}]}]},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":28}},"chosen":null},{"guarantee":{"GuaranteedAlignment":{"Deduplicated":39}},"chosen":null}],"inhabited":{"Deduplicated":4},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":{"InheritFrom":{"Deduplicated":16}},"marker_traits":null},{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":"ControlFlow","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"B","variance":"Covariant"},{"index":1,"name":"C","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[10,{"data":{"file_id":8,"beg":{"line":89,"col":21},"end":{"line":89,"col":22}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[11,{"data":{"file_id":8,"beg":{"line":89,"col":24},"end":{"line":89,"col":30}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["unique",0]},{"Ident":["Unique",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":35,"col":0},"end":{"line":35,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper around a raw non-null `*mut T` that indicates that the possessor"},{"DocComment":" of this wrapper owns the referent. Useful for building abstractions like"},{"DocComment":" `Box<T>`, `Vec<T>`, `String`, and `HashMap<K, V>`."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `Unique<T>` behaves \"as if\" it were an instance of `T`."},{"DocComment":" It implements `Send`/`Sync` if `T` is `Send`/`Sync`. It also implies"},{"DocComment":" the kind of strong aliasing guarantees an instance of `T` can expect:"},{"DocComment":" the referent of the pointer should not be modified without a unique path to"},{"DocComment":" its owning Unique."},{"DocComment":""},{"DocComment":" If you're uncertain of whether it's correct to use `Unique` for your purposes,"},{"DocComment":" consider using `NonNull`, which has weaker semantics."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<Unique<T>>` has the same size as `Unique<T>`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `Unique<T>` is covariant over `T`. This should always be correct"},{"DocComment":" for any type which upholds Unique's aliasing requirements."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Ident":["NonNull",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":79,"col":0},"end":{"line":79,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `*mut T` but non-zero and [covariant]."},{"DocComment":""},{"DocComment":" This is often the correct thing to use when building data structures using"},{"DocComment":" raw pointers, but is ultimately more dangerous to use because of its additional"},{"DocComment":" properties. If you're not sure if you should use `NonNull<T>`, just use `*mut T`!"},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<NonNull<T>>` has the same size as `*mut T`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `NonNull<T>` is covariant over `T`. This is usually the correct"},{"DocComment":" choice for most data structures and safe abstractions, such as `Box`, `Rc`, `Arc`, `Vec`,"},{"DocComment":" and `LinkedList`."},{"DocComment":""},{"DocComment":" In rare cases, if your type exposes a way to mutate the value of `T` through a `NonNull<T>`,"},{"DocComment":" and you need to prevent unsoundness from variance (for example, if `T` could be a reference"},{"DocComment":" with a shorter lifetime), you should add a field to make your type invariant, such as"},{"DocComment":" `PhantomData<Cell<T>>` or `PhantomData<&'a mut T>`."},{"DocComment":""},{"DocComment":" Example of a type that must be invariant:"},{"DocComment":" ```rust"},{"DocComment":" use std::cell::Cell;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":" struct Invariant<T> {"},{"DocComment":"     ptr: std::ptr::NonNull<T>,"},{"DocComment":"     _invariant: PhantomData<Cell<T>>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Notice that `NonNull<T>` has a `From` instance for `&T`. However, this does"},{"DocComment":" not change the fact that mutating through a (pointer derived from a) shared"},{"DocComment":" reference is undefined behavior unless the mutation happens inside an"},{"DocComment":" [`UnsafeCell<T>`]. The same goes for creating a mutable reference from a shared"},{"DocComment":" reference. When using this `From` instance without an `UnsafeCell<T>`,"},{"DocComment":" it is your responsibility to ensure that `as_mut` is never called, and `as_ptr`"},{"DocComment":" is never used for mutation."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `NonNull<T>` is guaranteed to have the same layout and bit validity as `*mut T`"},{"DocComment":" with the exception that a null pointer is invalid."},{"DocComment":" `Option<NonNull<T>>` is guaranteed to be ABI-compatible with `*mut T`, including in"},{"DocComment":" FFI."},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization],"},{"DocComment":" `NonNull<T>` and `Option<NonNull<T>>`"},{"DocComment":" are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<i16>>(), size_of::<Option<NonNull<i16>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<i16>>(), align_of::<Option<NonNull<i16>>>());"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<str>>(), size_of::<Option<NonNull<str>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<str>>(), align_of::<Option<NonNull<str>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [covariant]: https://doc.rust-lang.org/reference/subtyping.html"},{"DocComment":" [`PhantomData`]: crate::marker::PhantomData"},{"DocComment":" [`UnsafeCell<T>`]: crate::cell::UnsafeCell"},{"DocComment":" [null pointer optimization]: crate::option#representation"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"NonNull","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},null,null,{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["layout",0]},{"Ident":["Layout",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":30,"col":0},"end":{"line":30,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Layout of a block of memory."},{"DocComment":""},{"DocComment":" An instance of `Layout` describes a particular layout of memory."},{"DocComment":" You build a `Layout` up as an input to give to an allocator."},{"DocComment":""},{"DocComment":" All layouts have an associated size and a power-of-two alignment. The size, when rounded up to"},{"DocComment":" the nearest multiple of `align`, does not overflow `isize` (i.e., the rounded value will always be"},{"DocComment":" less than or equal to `isize::MAX`)."},{"DocComment":""},{"DocComment":" (Note that layouts are *not* required to have non-zero size,"},{"DocComment":" even though `GlobalAlloc` requires that all memory requests"},{"DocComment":" be non-zero in size. A caller must either ensure that conditions"},{"DocComment":" like this are met, use specific allocators with looser"},{"DocComment":" requirements, or use the more lenient `Allocator` interface.)"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"AllocLayout","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":4},"guarantee":null},"align":{"chosen":{"Deduplicated":17},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":558,"col":0},"end":{"line":558,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module documentation](self) for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":"Result","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"E","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[12,{"data":{"file_id":14,"beg":{"line":558,"col":16},"end":{"line":558,"col":17}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[13,{"data":{"file_id":14,"beg":{"line":558,"col":19},"end":{"line":558,"col":20}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["AllocError",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":32,"col":0},"end":{"line":32,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `AllocError` error indicates an allocation failure"},{"DocComment":" that may be due to resource exhaustion or to"},{"DocComment":" something wrong when combining the given input arguments with this"},{"DocComment":" allocator."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":0},"guarantee":null},"align":{"chosen":{"Deduplicated":2},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},null,{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["pin",0]},{"Ident":["Pin",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":1091,"col":0},"end":{"line":1091,"col":19}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer which pins its pointee in place."},{"DocComment":""},{"DocComment":" [`Pin`] is a wrapper around some kind of pointer `Ptr` which makes that pointer \"pin\" its"},{"DocComment":" pointee value in place, thus preventing the value referenced by that pointer from being moved"},{"DocComment":" or otherwise invalidated at that place in memory unless it implements [`Unpin`]."},{"DocComment":""},{"DocComment":" *See the [`pin` module] documentation for a more thorough exploration of pinning.*"},{"DocComment":""},{"DocComment":" ## Pinning values with [`Pin<Ptr>`]"},{"DocComment":""},{"DocComment":" In order to pin a value, we wrap a *pointer to that value* (of some type `Ptr`) in a"},{"DocComment":" [`Pin<Ptr>`]. [`Pin<Ptr>`] can wrap any pointer type, forming a promise that the **pointee**"},{"DocComment":" will not be *moved* or [otherwise invalidated][subtle-details]. If the pointee value's type"},{"DocComment":" implements [`Unpin`], we are free to disregard these requirements entirely and can wrap any"},{"DocComment":" pointer to that value in [`Pin`] directly via [`Pin::new`]. If the pointee value's type does"},{"DocComment":" not implement [`Unpin`], then Rust will not let us use the [`Pin::new`] function directly and"},{"DocComment":" we'll need to construct a [`Pin`]-wrapped pointer in one of the more specialized manners"},{"DocComment":" discussed below."},{"DocComment":""},{"DocComment":" We call such a [`Pin`]-wrapped pointer a **pinning pointer** (or pinning ref, or pinning"},{"DocComment":" [`Box`], etc.) because its existence is the thing that is pinning the underlying pointee in"},{"DocComment":" place: it is the metaphorical \"pin\" securing the data in place on the pinboard (in memory)."},{"DocComment":""},{"DocComment":" It is important to stress that the thing in the [`Pin`] is not the value which we want to pin"},{"DocComment":" itself, but rather a pointer to that value! A [`Pin<Ptr>`] does not pin the `Ptr` but rather"},{"DocComment":" the pointer's ***pointee** value*."},{"DocComment":""},{"DocComment":" The most common set of types which require pinning related guarantees for soundness are the"},{"DocComment":" compiler-generated state machines that implement [`Future`] for the return value of"},{"DocComment":" `async fn`s. These compiler-generated [`Future`]s may contain self-referential pointers, one"},{"DocComment":" of the most common use cases for [`Pin`]. More details on this point are provided in the"},{"DocComment":" [`pin` module] docs, but suffice it to say they require the guarantees provided by pinning to"},{"DocComment":" be implemented soundly."},{"DocComment":""},{"DocComment":" This requirement for the implementation of `async fn`s means that the [`Future`] trait"},{"DocComment":" requires all calls to [`poll`] to use a <code>self: [Pin]\\<&mut Self></code> parameter instead"},{"DocComment":" of the usual `&mut self`. Therefore, when manually polling a future, you will need to pin it"},{"DocComment":" first."},{"DocComment":""},{"DocComment":" You may notice that `async fn`-sourced [`Future`]s are only a small percentage of all"},{"DocComment":" [`Future`]s that exist, yet we had to modify the signature of [`poll`] for all [`Future`]s"},{"DocComment":" to accommodate them. This is unfortunate, but there is a way that the language attempts to"},{"DocComment":" alleviate the extra friction that this API choice incurs: the [`Unpin`] trait."},{"DocComment":""},{"DocComment":" The vast majority of Rust types have no reason to ever care about being pinned. These"},{"DocComment":" types implement the [`Unpin`] trait, which entirely opts all values of that type out of"},{"DocComment":" pinning-related guarantees. For values of these types, pinning a value by pointing to it with a"},{"DocComment":" [`Pin<Ptr>`] will have no actual effect."},{"DocComment":""},{"DocComment":" The reason this distinction exists is exactly to allow APIs like [`Future::poll`] to take a"},{"DocComment":" [`Pin<Ptr>`] as an argument for all types while only forcing [`Future`] types that actually"},{"DocComment":" care about pinning guarantees pay the ergonomics cost. For the majority of [`Future`] types"},{"DocComment":" that don't have a reason to care about being pinned and therefore implement [`Unpin`], the"},{"DocComment":" <code>[Pin]\\<&mut Self></code> will act exactly like a regular `&mut Self`, allowing direct"},{"DocComment":" access to the underlying value. Only types that *don't* implement [`Unpin`] will be restricted."},{"DocComment":""},{"DocComment":" ### Pinning a value of a type that implements [`Unpin`]"},{"DocComment":""},{"DocComment":" If the type of the value you need to \"pin\" implements [`Unpin`], you can trivially wrap any"},{"DocComment":" pointer to that value in a [`Pin`] by calling [`Pin::new`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" // Create a value of a type that implements `Unpin`"},{"DocComment":" let mut unpin_future = std::future::ready(5);"},{"DocComment":""},{"DocComment":" // Pin it by creating a pinning mutable reference to it (ready to be `poll`ed!)"},{"DocComment":" let my_pinned_unpin_future: Pin<&mut _> = Pin::new(&mut unpin_future);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Pinning a value inside a [`Box`]"},{"DocComment":""},{"DocComment":" The simplest and most flexible way to pin a value that does not implement [`Unpin`] is to put"},{"DocComment":" that value inside a [`Box`] and then turn that [`Box`] into a \"pinning [`Box`]\" by wrapping it"},{"DocComment":" in a [`Pin`]. You can do both of these in a single step using [`Box::pin`]. Let's see an"},{"DocComment":" example of using this flow to pin a [`Future`] returned from calling an `async fn`, a common"},{"DocComment":" use case as described above."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Call the async function to get a future back"},{"DocComment":" let fut = add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside a pinning box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::pin(fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a value which is already boxed, for example a [`Box<dyn Future>`][Box], you can pin"},{"DocComment":" that value in-place at its current memory address using [`Box::into_pin`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":" use std::future::Future;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn boxed_add_one(x: u32) -> Box<dyn Future<Output = u32>> {"},{"DocComment":"     Box::new(add_one(x))"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let boxed_fut = boxed_add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside the existing box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::into_pin(boxed_fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are similar pinning methods offered on the other standard library smart pointer types"},{"DocComment":" as well, like [`Rc`] and [`Arc`]."},{"DocComment":""},{"DocComment":" ### Pinning a value on the stack using [`pin!`]"},{"DocComment":""},{"DocComment":" There are some situations where it is desirable or even required (for example, in a `#[no_std]`"},{"DocComment":" context where you don't have access to the standard library or allocation in general) to"},{"DocComment":" pin a value which does not implement [`Unpin`] to its location on the stack. Doing so is"},{"DocComment":" possible using the [`pin!`] macro. See its documentation for more."},{"DocComment":""},{"DocComment":" ## Layout and ABI"},{"DocComment":""},{"DocComment":" [`Pin<Ptr>`] is guaranteed to have the same memory layout and ABI[^noalias] as `Ptr`."},{"DocComment":""},{"DocComment":" [^noalias]: There is a bit of nuance here that is still being decided about whether the"},{"DocComment":" aliasing semantics of `Pin<&mut T>` should be different than `&mut T`, but this is true as of"},{"DocComment":" today."},{"DocComment":""},{"DocComment":" [`pin!`]: crate::pin::pin \"pin!\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`pin` module]: self \"pin module\""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html \"Rc\""},{"DocComment":" [`Arc`]: ../../std/sync/struct.Arc.html \"Arc\""},{"DocComment":" [Box]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box`]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box::pin`]: ../../std/boxed/struct.Box.html#method.pin \"Box::pin\""},{"DocComment":" [`Box::into_pin`]: ../../std/boxed/struct.Box.html#method.into_pin \"Box::into_pin\""},{"DocComment":" [subtle-details]: self#subtle-details-and-the-drop-guarantee \"pin subtle details\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"Pin","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Ptr","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[14,{"data":{"file_id":17,"beg":{"line":1091,"col":15},"end":{"line":1091,"col":18}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null}],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["generic_stack",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":0},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Deduplicated":1},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"reg