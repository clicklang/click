ult,\n    }\n}\n\npub fn defaulted(x: i32) -> i32 {\n    unwrap_or(wrap(x), 0)\n}\n\npub fn plus_one(o: Option<u32>) -> Option<u32> {\n    let v = o?;\n    Some(v + 1)\n}\n\npub fn same<T: Copy>(o: Option<T>) -> Option<T> {\n    let v = o?;\n    Some(v)\n}\n\npub fn kept(x: u32) -> Option<u32> {\n    same(Some(x))\n}\n\npub fn passed(o: Option<u32>) -> Option<u32> {\n    o\n}\n\npub fn read_passed(o: Option<u32>) -> u32 {\n    match passed(o) {\n        Some(v) => v,\n        None => 0,\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["option_values",0]},{"Ident":["round",0]}]},{"key":{"Fun":1},"value":[{"Ident":["option_values",0]},{"Ident":["flagged",0]}]},{"key":{"Fun":2},"value":[{"Ident":["option_values",0]},{"Ident":["defaulted",0]}]},{"key":{"Fun":3},"value":[{"Ident":["option_values",0]},{"Ident":["plus_one",0]}]},{"key":{"Fun":4},"value":[{"Ident":["option_values",0]},{"Ident":["kept",0]}]},{"key":{"Fun":5},"value":[{"Ident":["option_values",0]},{"Ident":["read_passed",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[