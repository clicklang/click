covariant over `T`. This should always be correct"},{"DocComment":" for any type which upholds Unique's aliasing requirements."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None","marker_traits":null},null,null,{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["layout",0]},{"Ident":["Layout",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":30,"col":0},"end":{"line":30,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Layout of a block of memory."},{"DocComment":""},{"DocComment":" An instance of `Layout` describes a particular layout of memory."},{"DocComment":" You build a `Layout` up as an input to give to an allocator."},{"DocComment":""},{"DocComment":" All layouts have an associated size and a power-of-two alignment. The size, when rounded up to"},{"DocComment":" the nearest multiple of `align`, does not overflow `isize` (i.e., the rounded value will always be"},{"DocComment":" less than or equal to `isize::MAX`)."},{"DocComment":""},{"DocComment":" (Note that layouts are *not* required to have non-zero size,"},{"DocComment":" even though `GlobalAlloc` requires that all memory requests"},{"DocComment":" be non-zero in size. A caller must either ensure that conditions"},{"DocComment":" like this are met, use specific allocators with looser"},{"DocComment":" requirements, or use the more lenient `Allocator` interface.)"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"AllocLayout","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[25,{"Constant":{"Value":[12,[{"Integer":{"Unsigned":["Usize","16"]}},{"Deduplicated":5}]]}}]},"guarantee":null},"align":{"chosen":{"Value":[26,{"Constant":{"Value":[13,[{"Integer":{"Unsigned":["Usize","8"]}},{"Deduplicated":5}]]}}]},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":558,"col":0},"end":{"line":558,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module documentation](self) for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":"Result","has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"},{"index":1,"name":"E","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[7,{"data":{"f