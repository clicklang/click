 => match t {\n            Some(v) => v,\n            None => 0,\n        },\n    }\n}\n\npub fn take_param(o: &mut Option<u32>) -> Option<u32> {\n    o.take()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/alloc/src/boxed.rs"},"crate_name":"alloc","contents":null},{"id":4,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":5,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/alloc/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ptr/unique.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/alloc/layout.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ptr/non_null.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["option_take",0]},{"Ident":["taken",0]}]},{"key":{"Fun":1},"value":[{"Ident":["option_take",0]},{"Ident":["taken_twice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["option_take",0]},{"Ident":["scalar_taken",0]}]},{"key":{"Fun":3},"value":[{"Ident":["option_take",0]},{"Ident":["take_param",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}]},{"key":{"Type":2},"value":[{"Ident":["alloc",0]},{"Ident":["boxed",0]},{"Ident":["Box",0]}]},{"key":{"Type":3},"value":[{"Ident":["option_