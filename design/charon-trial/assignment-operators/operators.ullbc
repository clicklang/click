er;\n}\npub fn local(a: u32, b: u32) -> u32 {\n    let mut words = U32X4([a, b, 3, 4]);\n    words *= 2;\n    words %= 7;\n    words.0[0] ^ words.0[1]\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/arith.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Type":1},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["U32X4",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["click_charon_trial",0]},{"Impl":{"Trait":0}}]},{"key":{"TraitImpl":1},"value":[{"Ident":["click_charon_trial",0]},{"Impl":{"Trait":1}}]},{"key":{"TraitImpl":2},"value":[{"Ident":["click_charon_trial",0]},{"Impl":{"Trait":2}}]},{"key":{"Fun":0},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["scaled",0]}]},{"key":{"Fun":1},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["reduced",0]}]},{"key":{"Fun":2},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["added",0]}]},{"key":{"Fun":3},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["local",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]}]},{"key":{"Global":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["arith",0]},{"Ident":["RemAssign",0]}]},{"key":{"Type":2},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["arith",0]},{"Ident":["RemAssign",0]},{"Builtin":["VTable",0]}]},{"key":{"Global":1},"value":[{"Ident":["click_charon_trial",0]},{"Impl":{"Trait":0