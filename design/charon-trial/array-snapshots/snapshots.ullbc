 = Packet { prefix: 11, words: [a; 4], marker: 17 };\n    packet.words = [b, a, 3, 4];\n    packet.prefix + packet.marker\n}\npub fn sparse(a: u32, b: u32) -> u32 {\n    let mut source = [a; 1024];\n    source[3] = b;\n    let target = source;\n    source[3] = 99;\n    target[3]\n}\npub fn signed(a: i32, b: i32) -> i32 {\n    let words = Signed([a, b, -3]);\n    let next = words;\n    next.0[1]\n}\npub fn bytes(a: u8, b: u8) -> u8 {\n    let words = Bytes([a, b, 3]);\n    let next = words;\n    next.0[1]\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Type":1},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["Packet",0]}]},{"key":{"Type":2},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["Signed",0]}]},{"key":{"Type":3},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["Bytes",0]}]},{"key":{"Fun":0},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["computed_move",0]}]},{"key":{"Fun":1},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["source_write",0]}]},{"key":{"Fun":2},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["target_write",0]}]},{"key":{"Fun":3},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["replacement",0]}]},{"key":{"Fun":4},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["neighbors",0]}]},{"key":{"Fun":5},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["sparse",0]}]},{"key":{"Fun":6},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["signed",0]}]},{"key":{"Fun":7},"value":[{"Ident":["click_charon_trial",0]},{"Ident":["bytes",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core