fn put(&mut self, x: T);\n}\n\npub struct Slot {\n    pub value: i32,\n}\n\nimpl Holder<i32> for Slot {\n    fn put(&mut self, x: i32) {\n        self.value = x;\n    }\n}\n\npub fn store<H: Holder<i32>>(holder: &mut H, x: i32) {\n    holder.put(x);\n}\n\npub fn through_store(x: i32) -> i32 {\n    let mut slot = Slot { value: 0 };\n    store(&mut slot, x);\n    x\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["bags",0]},{"Ident":["through_fill",0]}]},{"key":{"Fun":1},"value":[{"Ident":["bags",0]},{"Ident":["through_dyn",0]}]},{"key":{"Fun":2},"value":[{"Ident":["bags",0]},{"Ident":["through_store",0]}]},{"key":{"Type":1},"value":[{"Ident":["bags",0]},{"Ident":["Counter",0]}]},{"key":{"Fun":3},"value":[{"Ident":["bags",0]},{"Ident":["fill",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]}]},{"key":{"Global":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["bags",0]},{"Ident":["Bag",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["bags",0]},{"Impl":{"Trait":0}}]},{"key":{"TraitDecl":3},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}]},{"key":{"Type":2},"value":[{"Ident":["bags",0]},{"Ident":["Bag",0]},{"Builtin":["VTable",0]}]},{"key":{"Global":1},"value":[{"Ident":["bags",0]},{"Impl":{"Trait":0}},{"Builtin":["VTable",0]}]},{"key":{"Fun":4},"value":[{"Ident":["bags",0]},{"Ident":["fill_dyn",0]}]},{"key":{"Type":3},"value":[{"Ident":["bags",0]},{"Ident":["Slot",0]}]},{"key":{"Fun":5},"value":[{"Ident":["bags",0]},{"Ident":["stor