{"extractor_revision":"5d6b812e5f77dbf3d7f66c21b9b57091f0e084cb","compiler_commit":"923c95cdf5ba65cea505aa2ea829f578e1506ed8","profile":"click-charon-optimized-abort-checked-v1","flags":["--target=x86_64-unknown-linux-gnu","-Cpanic=abort","-Coverflow-checks=on","-Zmir-opt-level=0","--edition=2021"],"crate_config":{"name":"trait_objects","edition":"2021","features":[],"roots":["trait_objects::through_bound","trait_objects::through_dyn","trait_objects::reset_square","trait_objects::reset_dyn_square"],"files":["shapes.rs"]},"crate_profile":"click-charon-crate-v4","data":{"charon_version":"0.1.279","translated":{"crate_name":"trait_objects","options":{"ullbc":true,"precise_drops":true,"mir":"Optimized","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["trait_objects::through_bound","trait_objects::through_dyn","trait_objects::reset_square","trait_objects::reset_dyn_square"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":["core","alloc","std"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":[],"hide_marker_traits":false,"hide_allocator":false,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":false,"remove_adt_clauses":false,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":false,"index_to_function_calls":false,"treat_box_as_builtin":false,"no_gen_tuple_structs":false,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":false,"reconstruct_asserts":false,"reconstruct_matches":false,"deallocate_all_locals":false,"unbind_item_vars":false,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":"trial.ullbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":true,"preset":null},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"shapes.rs"},"crate_name":"trait_objects","contents":"//! Trait methods whose interface reads the object through model functions:\n//! `size` is `side` for a `Square` and `radius + radius` for a `Circle`, and\n//! `total` and `dynamic` reach `area` through a bound and `&dyn Shape`.\n//! `set` changes the object through `&mut self`, which `reset` and\n//! `reset_dyn` reach through `&mut T` and `&mut dyn Shape`.\n\npub trait Shape {\n    fn area(&self, scale: i32) -> i32;\n    fn set(&mut self, half: i32);\n}\n\npub struct Square {\n    pub side: i32,\n}\n\npub struct Circle {\n    pub radius: i32,\n}\n\nimpl Shape for Square {\n    fn area(&self, scale: i32) -> i32 {\n        self.side + scale\n    }\n\n    fn set(&mut self, half: i32) {\n        self.side = half + half;\n    }\n}\n\nimpl Shape for Circle {\n    fn area(&self, scale: i32) -> i32 {\n        self.radius + self.radius + scale\n    }\n\n    fn set(&mut self, half: i32) {\n        self.radius = half;\n    }\n}\n\nfn total<T: Shape>(shape: &T, scale: i32) -> i32 {\n    shape.area(scale)\n}\n\nfn dynamic(shape: &dyn Shape, scale: i32) -> i32 {\n    shape.area(scale)\n}\n\npub fn through_bound(scale: i32) -> i32 {\n    let square = Square { side: 3 };\n    total(&square, scale)\n}\n\npub fn through_dyn(scale: i32) -> i32 {\n    let circle = Circle { radius: 2 };\n    dynamic(&circle, scale)\n}\n\nfn reset<T: Shape>(shape: &mut T, half: i32) {\n    shape.set(half);\n}\n\nfn reset_dyn(shape: &mut dyn Shape, half: i32) {\n    shape.set(half);\n}\n\npub fn reset_square(half: i32) -> i32 {\n    let mut square = Square { side: 1 };\n    reset(&mut square, half);\n    square.side\n}\n\npub fn reset_dyn_square(half: i32) -> i32 {\n    let mut square = Square { side: 9 };\n    reset_dyn(&mut square, half);\n    square.side\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["trait_objects",0]},{"Ident":["through_bound",0]}]},{"key":{"Fun":1},"value":[{"Ident":["trait_objects",0]},{"Ident":["through_dyn",0]}]},{"key":{"Fun":2},"value":[{"Ident":["trait_objects",0]},{"Ident":["reset_square",0]}]},{"key":{"Fun":3},"value":[{"Ident":["trait_objects",0]},{"Ident":["reset_dyn_square",0]}]},{"key":{"Type":1},"value":[{"Ident":["trait_objects",0]},{"Ident":["Square",0]}]},{"key":{"Fun":4},"value":[{"Ident":["trait_objects",0]},{"Ident":["total",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ide