alue: 0, puts: 7 };\n    store_dyn(&mut wrap, x)\n}\n\npub fn through_peek(level: i32) -> u32 {\n    let wrap = Wrap { value: level, puts: 7 };\n    let seen = peek(&wrap);\n    if seen == level {\n        wrap.puts\n    } else {\n        0\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["generic_state",0]},{"Ident":["through",0]}]},{"key":{"Fun":1},"value":[{"Ident":["generic_state",0]},{"Ident":["through_dyn",0]}]},{"key":{"Fun":2},"value":[{"Ident":["generic_state",0]},{"Ident":["through_peek",0]}]},{"key":{"Type":1},"value":[{"Ident":["generic_state",0]},{"Ident":["Wrap",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]}]},{"key":{"Global":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}]},{"key":{"Fun":3},"value":[{"Ident":["generic_state",0]},{"Ident":["store",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["generic_state",0]},{"Ident":["Holder",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["generic_state",0]},{"Impl":{"Trait":0}}]},{"key":{"TraitDecl":4},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Copy",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Impl":{"Trait":1}}]},{"key":{"Type":2},"value":[{"Ident":["generic_state",0]},{"Ident":["Holder",0]},{"Builtin":["VTable",0]}]},{"key":{"Global":1},"value":[{"Ident":["generic_state",0]}