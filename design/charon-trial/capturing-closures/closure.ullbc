" calling it concurrently). If you do not need such strict requirements, use"},{"DocComment":" [`FnMut`] or [`FnOnce`] as bounds."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Calling a closure"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let square = |x| x * x;"},{"DocComment":" assert_eq!(square(5), 25);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Using a `Fn` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn call_with_one<F>(func: F) -> usize"},{"DocComment":"     where F: Fn(usize) -> usize {"},{"DocComment":"     func(1)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let double = |x| x * 2;"},{"DocComment":" assert_eq!(call_with_one(double), 2);"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"Fn","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[37,{"data":{"file_id":3,"beg":{"line":76,"col":0},"end":{"line":80,"col":1}},