ocComment":""},{"DocComment":" `Fn` is implemented automatically by closures which only take immutable"},{"DocComment":" references to captured variables or don't capture anything at all, as well"},{"DocComment":" as (safe) [function pointers] (with some caveats, see their documentation"},{"DocComment":" for more details). Additionally, for any type `F` that implements `Fn`, `&F`"},{"DocComment":" implements `Fn`, too."},{"DocComment":""},{"DocComment":" Since both [`FnMut`] and [`FnOnce`] are supertraits of `Fn`, any"},{"DocComment":" instance of `Fn` can be used as a parameter where a [`FnMut`] or [`FnOnce`]"},{"DocComment":" is expected."},{"DocComment":""},{"DocComment":" Use `Fn` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and need to call it repeatedly and without mutating state (e.g., when"},{"DocComment":" calling it concurrently). If you do not need such strict requirements, use"},{"DocComment":" [`FnMut`] or [`FnOnce`] as bounds."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Calling a closure"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let square = |x| x * x;"},{"DocComment":" assert_eq!(square(5), 25);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Using a `Fn` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn call_with_one<F>(func: F) -> usize"},{"DocComment":"     where F: Fn(usize) -> usize {"},{"DocComment":"     func(1)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let double = |x| x * 2;"},{"DocComment":" assert_eq!(call_with_one(double), 2);"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":"Fn","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[84,{"data":{"file_id":3,"beg":{"line":76,"col":0},"end":{"line":80,"col":1}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[85,{"data":{"file_id":3,"beg":{"line":76,"col":33},"end":{"line":76,"col":52}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":0},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[86,{"data":{"file_id":3,"beg":{"line":76,"col":19},"end":{"line":76,"col":23}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[87,{"data":{"file_id":3,"beg":{"line":76,"col":25},"end":{"line":76,"col":30}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":8}],"const_generics":[],"trai