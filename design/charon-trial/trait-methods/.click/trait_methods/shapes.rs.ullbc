re = Square { side: 3 };\n    total(&square, scale)\n}\n\npub fn through_dyn(scale: i32) -> i32 {\n    let circle = Circle { radius: 2 };\n    dynamic(&circle, scale)\n}\n\npub fn direct(scale: i32) -> i32 {\n    let square = Square { side: 1 };\n    square.area(scale)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["trait_methods",0]},{"Ident":["through_bound",0]}]},{"key":{"Fun":1},"value":[{"Ident":["trait_methods",0]},{"Ident":["through_dyn",0]}]},{"key":{"Fun":2},"value":[{"Ident":["trait_methods",0]},{"Ident":["direct",0]}]},{"key":{"Type":1},"value":[{"Ident":["trait_methods",0]},{"Ident":["Square",0]}]},{"key":{"Fun":3},"value":[{"Ident":["trait_methods",0]},{"Ident":["total",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]}]},{"key":{"Global":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]},{"Builtin":["VTable",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["trait_methods",0]},{"Ident":["Shape",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["trait_methods",0]},{"Impl":{"Trait":0}}]},{"key":{"TraitDecl":3},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}]},{"key":{"Type":2},"value":[{"Ident":["trait_methods",0]},{"Ident":["Circle",0]}]},{"key":{"Type":3},"value":[{"Ident":["trait_methods",0]},{"Ident":["Shape",0]},{"Builtin":["VTable",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["trait_methods",0]},{"Impl":{"Trait":1}}]},{"key":{"Global":1},"value":[{"Ident":["trait_methods",0]},{"Impl":{"Trait":1}},{"Builtin":["VTable",0]}]},{"key":{"Fun":4},"value":[{"Ident":["trait_methods",0]},{