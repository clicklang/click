{
  "units": {
    "zlib": {
      "language": "c",
      "root": "zlib",
      "compiler": "/usr/bin/gcc",
      "env": {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C",
        "SOURCE_DATE_EPOCH": "0"
      },
      "args": [
        "-std=c11"
      ],
      "sources": {
        "adler32.c": {},
        "incremental.c": {}
      }
    },
    "adler2": {
      "language": "rust",
      "root": "adler2",
      "sources": {
        "src/lib.rs": {}
      },
      "crate": {
        "name": "adler2",
        "edition": "2021",
        "features": [
          "std"
        ],
        "roots": [
          "adler2::adler32_slice",
          "adler2::Adler32::from_checksum"
        ],
        "files": [
          "src/lib.rs",
          "src/algo.rs"
        ]
      }
    },
    "adler_incremental": {
      "language": "rust",
      "root": "adler2",
      "sources": {
        "incremental.rs": {}
      },
      "crate": {
        "name": "adler_incremental",
        "edition": "2021",
        "features": [
          "std"
        ],
        "roots": [
          "adler_incremental::incremental"
        ],
        "files": [
          "incremental.rs",
          "src/lib.rs",
          "src/algo.rs"
        ]
      }
    },
    "adler_resumed": {
      "language": "rust",
      "root": "adler2",
      "sources": {
        "resumed.rs": {}
      },
      "crate": {
        "name": "adler_resumed",
        "edition": "2021",
        "features": [
          "std"
        ],
        "roots": [
          "adler_resumed::resumed"
        ],
        "files": [
          "resumed.rs",
          "src/lib.rs",
          "src/algo.rs"
        ]
      }
    }
  }
}
